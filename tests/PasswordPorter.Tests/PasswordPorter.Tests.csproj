<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PasswordPorter.Core\PasswordPorter.Core.csproj" />
    <ProjectReference Include="..\..\src\PasswordPorter.Firefox\PasswordPorter.Firefox.csproj" />
    <ProjectReference Include="..\..\src\PasswordPorter.KeePass\PasswordPorter.KeePass.csproj" />
  </ItemGroup>

  <!--
    Cross-check against the real KeePass implementation. KeePass.exe is a .NET Framework assembly
    containing KeePassLib, so on net48 we can reference it directly. Point KeePassExe at another
    copy with -p:KeePassExe=... if needed; the tests are skipped when it is absent.
  -->
  <PropertyGroup>
    <KeePassExe Condition="'$(KeePassExe)' == ''">$([System.IO.Directory]::GetParent($(MSBuildProjectDirectory)).Parent.FullName)\KeePass-2.61.1\KeePass.exe</KeePassExe>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48' And Exists('$(KeePassExe)')">
    <Reference Include="KeePass">
      <HintPath>$(KeePassExe)</HintPath>
    </Reference>
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48' And Exists('$(KeePassExe)')">
    <DefineConstants>$(DefineConstants);HAVE_KEEPASSLIB</DefineConstants>
  </PropertyGroup>

</Project>
