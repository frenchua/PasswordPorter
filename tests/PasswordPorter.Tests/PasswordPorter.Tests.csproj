<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PasswordPorter.Core\PasswordPorter.Core.csproj" />
    <ProjectReference Include="..\..\src\PasswordPorter.Firefox\PasswordPorter.Firefox.csproj" />
    <ProjectReference Include="..\..\src\PasswordPorter.KeePass\PasswordPorter.KeePass.csproj" />
  </ItemGroup>

  <!--
    Cross-check against the real KeePass. KeePassLib only runs on .NET Framework, so the
    KeePassCheck helper (net48) wraps it and the tests run it as a separate process.
    Point KeePassExe at another copy with -p:KeePassExe=...; the tests are skipped when it is absent.
  -->
  <PropertyGroup>
    <KeePassExe Condition="'$(KeePassExe)' == ''">$(MSBuildThisFileDirectory)..\..\KeePass-2.61.1\KeePass.exe</KeePassExe>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(KeePassExe)')">
    <!-- Build order only: the helper is a different framework and is not referenced as a library. -->
    <ProjectReference Include="..\KeePassCheck\KeePassCheck.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
    <AssemblyMetadata Include="KeePassCheckExe"
                      Value="$(MSBuildThisFileDirectory)..\KeePassCheck\bin\$(Configuration)\net48\KeePassCheck.exe" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(KeePassExe)')">
    <DefineConstants>$(DefineConstants);HAVE_KEEPASSCHECK</DefineConstants>
  </PropertyGroup>

</Project>
